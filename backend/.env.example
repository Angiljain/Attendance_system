# Database
DATABASE_URL="postgresql://user:password@localhost:5432/attendance_db?schema=public"

# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# QR Code
QR_SECRET=your-hmac-secret-key-change-in-production
QR_VALIDITY_SECONDS=20

# Geofencing
GEOFENCE_RADIUS_METERS=70

# Blockchain (optional)
BLOCKCHAIN_ENABLED=false
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com
PRIVATE_KEY=your-wallet-private-key
PROOF_CONTRACT_ADDRESS=
POAP_CONTRACT_ADDRESS=

# IPFS (optional)
IPFS_API_URL=https://api.pinata.cloud
IPFS_API_KEY=
IPFS_API_SECRET=
